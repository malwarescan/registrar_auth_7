# NameSilo API key. When set, the server fetches every active NameSilo
# expired-domain auction on boot and every 6 hours (see README.md).
# Leave empty to serve the committed snapshot in data/namesilo-auctions-snapshot.json.
NAMESILO_API_KEY=
USE_MOCK_FALLBACK=false
PORT=4173
PUBLIC_BASE_URL=https://urlsnatcher.com
